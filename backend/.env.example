# Скопируйте в .env и подставьте значения:
#   copy .env.example .env

# Токен от @BotFather
BOT_TOKEN=

# Локальная отладка в браузере без Telegram WebView: см. backend/scripts/dev_telegram_init_data.py
# (генерирует подписанный initData и команду flutter build web --dart-define=TELEGRAM_INIT_DATA=...)

# URL веб-приложения (Flutter Web):
# - Встроенный Web App в Telegram — только HTTPS (Bot API отклоняет http для web_app).
# - Локально без HTTPS: WEB_APP_URL=http://127.0.0.1:8080 — бот шлёт обычную ссылку «Открыть в браузере».
# - Полноценный Web App: cloudflared/ngrok → https://... на порт со статикой.
WEB_APP_URL=http://127.0.0.1:8080

# База данных (локально часто postgres в Docker на 5433)
DATABASE_URL=postgresql://connectit_user:connectit_password@localhost:5433/connectit_db

# --- Доступ бота к api.telegram.org (НЕ путать с прокси в настройках Telegram) ---
# Прокси MTProto (hostname:port) из Telegram НЕ работает для Python — нужен HTTP или SOCKS5
# на этом же ПК, как в Clash / v2rayN / NekoBox (обычно 127.0.0.1:7890 HTTP или :1080 SOCKS5).
# Примеры:
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
# TELEGRAM_PROXY_URL=
